# PostgreSQL
POSTGRES_DB=ecommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# JWT
JWT_SECRET_KEY=change-me-to-a-random-secret

# Stripe
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Temporary-data maintenance (automatic cleanup of expired idempotency
# records and expired/revoked refresh tokens)
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_HOURS=24

# Database schema initialization (Alembic is the schema authority; enable only
# for quick local runs without Docker/Alembic)
CREATE_SCHEMA_ON_STARTUP=false

# Frontend
VITE_API_URL=http://localhost:8000

# Build metadata (optional)
VERSION=1.0.0
COMMIT=unknown
BUILD_DATE=unknown
